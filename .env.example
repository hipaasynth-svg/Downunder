# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Required to run the agent (the LLM client is built lazily on first use).
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults preserve current behaviour) ---
# LLM model id
# DOWNUNDER_MODEL=claude-opus-4-8

# The bar this agent works for
# DOWNUNDER_BAR_NAME=Down Under
# DOWNUNDER_BAR_CITY=Minot, ND

# DrinkMinot loyalty platform the agent reads (GET /api/state) and the bar's
# frozen venue id. A customer taps the in-store tag at <drink_url>/?r=<venue_id>.
# DOWNUNDER_DRINK_URL=https://drinkminot.com
# DOWNUNDER_VENUE_ID=63

# Weather (US National Weather Service, api.weather.gov — free, no key). The
# nightly brief factors tonight's forecast in. Defaults to downtown Minot, ND.
# DOWNUNDER_WEATHER_LAT=48.2325
# DOWNUNDER_WEATHER_LON=-101.2963

# --- Nearby events (Ticketmaster Discovery API — free key) ---
# Lists concerts/games/fairs near the bar that pull crowds downtown. Get a free
# key at developer.ticketmaster.com. Without it, the events step is skipped.
# TICKETMASTER_API_KEY=
# DOWNUNDER_EVENT_RADIUS_MILES=30
# DOWNUNDER_EVENT_DAYS_AHEAD=7

# --- Auto-populate the curated Minot feed from PredictHQ (richest source) ---
# Create an Events-scoped token at predicthq.com (Free tier covers one nightly
# query). Needs BOTH the token AND your DrinkMinot admin password, so the
# nightly sync can write the events into /api/events (source 'predicthq').
# Without both, the auto-sync simply doesn't run.
# PREDICTHQ_TOKEN=
# DRINK_ADMIN_PASSWORD=

# Repo ownership (any site changes ship only via PR)
# DOWNUNDER_GITHUB_OWNER=hipaasynth-svg
# DOWNUNDER_GITHUB_REPO=drinkminot
# DOWNUNDER_DEFAULT_BRANCH=main

# Bar voice lock — path to the editable voice bible (default: VOICE_BIBLE.md).
# DOWNUNDER_VOICE_BIBLE=VOICE_BIBLE.md

# Local state persistence
# DOWNUNDER_STATE_PATH=downunder_state.json

# --- Email the nightly brief to yourself via Zoho Mail (agents/mail.py) ---
# Use a Zoho APP PASSWORD, not the account login. The only email this sends is
# YOUR OWN brief to yourself — it never messages customers.
# ZOHO_MAIL_USER=cody@drinkminot.com
# ZOHO_MAIL_PASSWORD=
# Optional SMTP overrides (defaults shown):
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465

# --- Cartoons: render the nightly strip as an image (agents/gemini.py) ---
# Google Gemini 2.5 Flash Image ("Nano Banana") key from Google AI Studio.
# With it, the agent draws a recurring cast + a nightly cartoon strip (~$0.04
# per image) and attaches the strip to your brief. Without it, the cartoon step
# still writes the strip as a text storyboard — it just doesn't render images.
# GEMINI_API_KEY=

# --- v2: nearby-venue recruiting scan (Google Places API "New") ---
# Powers the future "recruit nearby Main St venues onto DrinkMinot" density
# play (agents/search.py). Not wired into the nightly run yet. Without it,
# search_configured() is False and the scan stays off.
# DOWNUNDER_SEARCH_API_KEY=
